# 维多利亚伦敦探案 — 后端环境配置

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# 服务器
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=7d

# 游客模式
GUEST_EXPIRE_HOURS=24

# 存储模式：local=强制 SQLite；supabase=强制 Supabase；auto=按 Supabase 凭据自动（默认）
STORAGE_MODE=auto

# SQLite 数据库路径（仅本地模式生效）。留空则默认落到【仓库外】持久位置，账号跨克隆/合并/重装不丢：
#   Windows:      %APPDATA%/sherlock-detective/local_dev.db
#   macOS/Linux:  ~/.sherlock-detective/local_dev.db
# Docker 部署由 docker-compose.yml 的 SQLITE_PATH=/data/local_dev.db（命名卷持久化）覆盖本项。
# ⚠️ 切勿把它指回仓库内 backend/data/（会被 .gitignore 忽略，克隆/合并/重装即丢失）。
SQLITE_PATH=

