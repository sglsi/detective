# Godot 4+ specific ignores
.godot/
/android/
# ===== 依赖 =====
node_modules/
**/node_modules/

# ===== Godot 生成物（CI 通过 --import 重新生成�?====
*.import
# ===== 密钥/环境 =====
.env
*.env
.env.*
!.env.example
# ===== 日志/缓存 =====
*.log
__pycache__/
.DS_Store
*.tmp
*.swp
# ===== 运行时产�?=====
dist/
build/
coverage/

# Godot web build pck (build artifact, regenerated locally via export; not versioned)
godot_project/web_build/index.pck

# ===== AI agent workspace (session data, not game code) =====
/agent/

# Godot 4.x 生成的 UID 缓存（编辑器产物，非源码）
*.uid
