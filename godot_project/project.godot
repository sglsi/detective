; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="维多利亚伦敦探案"
config/description="以福尔摩斯第一视角，体验19世纪维多利亚时代伦敦的推理探案过程"
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"
config/api_base_url="http://127.0.0.1:3001"

[autoload]

SettingsManager="*res://autoload/settings_manager.gd"
APIConfig="*res://config/api_config.gd"
SystemEventBus="*res://autoload/system_event_bus.gd"
SceneEventBus="*res://autoload/scene_event_bus.gd"
DialogueEventBus="*res://autoload/dialogue_event_bus.gd"
ClueEventBus="*res://autoload/clue_event_bus.gd"
UIEventBus="*res://autoload/ui_event_bus.gd"
CaseEventBus="*res://autoload/case_event_bus.gd"
MapEventBus="*res://autoload/map_event_bus.gd"
DifficultyManager="*res://autoload/difficulty_manager.gd"
GameManager="*res://autoload/game_manager.gd"
CaseManager="*res://autoload/case_manager.gd"
ClueSystem="*res://autoload/clue_system.gd"
StarRatingSystem="*res://autoload/star_rating_system.gd"
APIManager="*res://autoload/api_manager.gd"
AuthManager="*res://autoload/auth_manager.gd"
SaveManager="*res://autoload/save_manager.gd"
UIManager="*res://autoload/ui_manager.gd"
NotificationSystem="*res://scripts/ui/notification.gd"
MapManager="*res://autoload/map_manager.gd"
DialogueProgress="*res://autoload/dialogue_progress.gd"
AudioManager="*res://autoload/audio_manager.gd"
GameStateMachine="*res://autoload/game_state_machine.gd"
SaveSystem="*res://autoload/save_system.gd"
BadgeSystem="*res://autoload/badge_system.gd"
EndingSystem="*res://autoload/ending_system.gd"
ProgressSystem="*res://autoload/progress_system.gd"
TimelineSystem="*res://autoload/timeline_system.gd"
KnowledgeBaseSystem="*res://autoload/knowledge_base_system.gd"
ToolSystem="*res://autoload/tool_system.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/simhei.ttf"

[input]

